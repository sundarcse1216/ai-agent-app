# Copy this file to .env and fill in the values you need.

# Which LLM backend powers chat/RAG/classification/weather-location-extraction/
# SQL-generation/recommendation-extraction: "ollama" (local, default) or "openai".
LLM_PROVIDER=ollama

# Required if LLM_PROVIDER=openai, and always required for image generation
# (agents/image_agent.py uses OpenAI's gpt-image-1 regardless of LLM_PROVIDER).
OPENAI_API_KEY=

# Optional: override the OpenAI chat model used when LLM_PROVIDER=openai.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Required for WeatherAgent / RecommendationAgent (weatherapi.com).
WEATHER_API_KEY=

# Optional: LangSmith tracing (https://smith.langchain.com). No-op unless
# LANGCHAIN_TRACING_V2=true. Covers every agent's LLM calls, not just the
# LangChain-based RAGAgent.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent-app

# Hard per-session LLM cost cap in USD (see core/cost_tracking.py). Always
# $0 for Ollama calls, so this only actually limits anything when
# LLM_PROVIDER=openai. Doesn't cover RAG or image-generation cost.
MAX_COST_PER_SESSION_USD=0.50

# Comma-separated extra CORS origins allowed to call this API, beyond the
# hardcoded Vite dev origin (http://localhost:5173). Set this to your
# deployed frontend's origin, e.g. https://your-site.netlify.app
ALLOWED_ORIGINS=
