# Python backend (FastAPI). Only what api/app.py's import graph needs —
# main.py/demo.py/ui.py (console entry points) aren't copied since this
# image's job is just the web API.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agents/ agents/
COPY api/ api/
COPY core/ core/
COPY database/ database/
COPY documents/ documents/
COPY exception/ exception/
# Committed pre-built FAISS index (see vectorstore/faiss_index/) — docker
# compose ships this via a bind mount instead, but a plain `docker build`
# (e.g. on Render, which has no such mount) needs it copied in, or
# RAGAgent silently rebuilds it from documents/ on every cold start.
COPY vectorstore/ vectorstore/
COPY config.py logger.py ./

EXPOSE 8000

# $PORT is set by Render (and similar PaaS) at runtime; defaults to 8000 for
# local `docker compose up` where it's unset. Shell form (not exec-form JSON
# array) so the ${PORT:-8000} expansion actually happens.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://localhost:' + os.environ.get('PORT', '8000') + '/api/healthz')" || exit 1

CMD uvicorn api.app:app --host 0.0.0.0 --port ${PORT:-8000}
